# Copie a .env y complete localmente; nunca versione el archivo real.
TYPESAFE_API_KEY=replace-with-a-local-key
TYPESAFE_BASE_URL=https://api.typesafe.ai
TYPESAFE_DEFAULT_MODEL=jev-1.13.0
CATALOG_JUDGE_ALLOW_REMOTE=0
CATALOG_JUDGE_TIMEOUT=20
# Mantener warning en clientes y no registrar bodies.
TYPESAFE_LOG_LEVEL=warning
